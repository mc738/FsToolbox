<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Types.fs" />
        <Compile Include="Geometry.fs" />
        <Compile Include="Shaders.fs" />
        <Compile Include="Textures.fs" />
        <Compile Include="Materials.fs" />
        <Compile Include="Render.fs" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
      <PackageReference Include="StbImageSharp" Version="2.30.16" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\FsToolbox.GameDevelopment\FsToolbox.GameDevelopment.fsproj" />
    </ItemGroup>

</Project>
